<mxfile host="app.diagrams.net" agent="docs/zh/product_flow.py"><diagram id="product_flow" name="Product flow"><mxGraphModel dx="1180" dy="1188" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="1188" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="phase_try" value="&lt;b&gt;试用&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;1 分钟,不装任何东西&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f9f7;strokeColor=#d8dcd9;fontColor=#6b6f6c;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="68" width="1140" height="92" as="geometry"/></mxCell><mxCell id="phase_setup" value="&lt;b&gt;建立&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;约 20 分钟,只做一次&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f9f7;strokeColor=#d8dcd9;fontColor=#6b6f6c;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="188" width="1140" height="404" as="geometry"/></mxCell><mxCell id="phase_month" value="&lt;b&gt;每月&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;导入日,默认 26 号&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f9f7;strokeColor=#d8dcd9;fontColor=#6b6f6c;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="620" width="1140" height="358" as="geometry"/></mxCell><mxCell id="phase_always" value="&lt;b&gt;随时&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;每周、每季、工具更新时&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f9f7;strokeColor=#d8dcd9;fontColor=#6b6f6c;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1006" width="1140" height="170" as="geometry"/></mxCell><mxCell id="col_you" value="你" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;fontColor=#1c1c1a;" vertex="1" parent="1"><mxGeometry x="170" y="24" width="300" height="32" as="geometry"/></mxCell><mxCell id="col_jr" value="JADE TOAD" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;fontColor=#4a3aa7;" vertex="1" parent="1"><mxGeometry x="500" y="24" width="300" height="32" as="geometry"/></mxCell><mxCell id="col_page" value="页面" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;fontColor=#2a78d6;" vertex="1" parent="1"><mxGeometry x="830" y="24" width="300" height="32" as="geometry"/></mxCell><mxCell id="t_open" value="克隆仓库,双击打开 dashboards/finance_dashboard.html。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfcfb;strokeColor=#1c1c1a;strokeWidth=2;fontColor=#1c1c1a;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="170" y="86" width="300" height="56" as="geometry"/></mxCell><mxCell id="t_demo" value="Emma Roy 的一年:19 页,全部合成数据,余额链照样闭合。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfcfb;strokeColor=#2a78d6;strokeWidth=2;fontColor=#1c1c1a;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="830" y="86" width="300" height="56" as="geometry"/></mxCell><mxCell id="s_drop" value="把上个月的文件丢进 inbox/:银行对账单、券商的持仓和活动导出、海外账户截图。文件名不改。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfcfb;strokeColor=#1c1c1a;strokeWidth=2;fontColor=#1c1c1a;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="170" y="206" width="300" height="56" as="geometry"/></mxCell><mxCell id="s_say" value="说「set this up」。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfcfb;strokeColor=#1c1c1a;strokeWidth=2;fontColor=#1c1c1a;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="170" y="292" width="300" height="40" as="geometry"/></mxCell><mxCell id="s_draft" value="逐份读文件,起草账户表、每月文件表和第一版计划;列出文件答不了的问题。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfcfb;strokeColor=#4a3aa7;strokeWidth=2;fontColor=#1c1c1a;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="500" y="284" width="300" height="56" as="geometry"/></mxCell><mxCell id="s_ans" value="对着表格改错处,回答约 12 个问题:显示的名字、出生年、日常额度、投资桶、海外资产……" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfcfb;strokeColor=#1c1c1a;strokeWidth=2;fontColor=#1c1c1a;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="170" y="362" width="300" height="56" as="geometry"/></mxCell><mxCell id="s_write" value="问题没清零就拒绝写入。清零后生成 findata/register/,账本留空,重建页面。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfcfb;strokeColor=#4a3aa7;strokeWidth=2;fontColor=#1c1c1a;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="500" y="440" width="300" height="56" as="geometry"/></mxCell><mxCell id="s_page" value="名字、账户、计划已就位;历史为空,每一页都说明「还没有导入」,而不是显得坏了。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfcfb;strokeColor=#2a78d6;strokeWidth=2;fontColor=#1c1c1a;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="830" y="518" width="300" height="56" as="geometry"/></mxCell><mxCell id="m_remind" value="导入日早上提醒:哪些文件到了,哪些还缺。只读不写。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfcfb;strokeColor=#4a3aa7;strokeWidth=2;fontColor=#1c1c1a;fontSize=12;align=left;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="500" y="638" width="300" height="56" as="geometry"/></mxCell><mxCell id="m_drop" value="从各银行下载本月对账单和导出,丢进 inbox/。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfcfb;strokeColor=#1c1c1a;strokeWidth=2;fontColor=#1c1c1a;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="170" y="646" width="300" height="40" as="geometry"/></mxCell><mxCell id="m_say" value="说「update dashboards」。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfcfb;strokeColor=#1c1c1a;strokeWidth=2;fontColor=#1c1c1a;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="170" y="732" width="300" height="40" as="geometry"/></mxCell><mxCell id="m_run" value="一条本地命令做完:认出每份文件、按内容查重 → 解析器逐份读,对平了才写 → 商户分类 → 写数据 → 重建页面 → 归档原件。模型只看摘要。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfcfb;strokeColor=#4a3aa7;strokeWidth=2;fontColor=#1c1c1a;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="500" y="716" width="300" height="72" as="geometry"/></mxCell><mxCell id="m_report" value="Records → Updates 就是报告:变了什么 · 问你什么 · 注意到什么 · 替你决定了什么 · 收到哪些文件。页头一句话:数据到哪、缺什么、几项待答。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfcfb;strokeColor=#2a78d6;strokeWidth=2;fontColor=#1c1c1a;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="830" y="810" width="300" height="72" as="geometry"/></mxCell><mxCell id="m_read" value="读报告;回答待确认项:新商户、没有署名的 e-Transfer、解析器读不了的文件。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfcfb;strokeColor=#1c1c1a;strokeWidth=2;fontColor=#1c1c1a;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="170" y="818" width="300" height="56" as="geometry"/></mxCell><mxCell id="m_file" value="一句话即归档:答案写回商户表和账本的类型列,页面重建。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfcfb;strokeColor=#4a3aa7;strokeWidth=2;fontColor=#1c1c1a;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="500" y="904" width="300" height="56" as="geometry"/></mxCell><mxCell id="a_look" value="每周看 This month:额度还剩多少。每季过一遍 Investing → Rules 和 Checkpoints。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfcfb;strokeColor=#1c1c1a;strokeWidth=2;fontColor=#1c1c1a;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="170" y="1024" width="300" height="56" as="geometry"/></mxCell><mxCell id="a_dots" value="侧边栏圆点:琥珀 = 看一眼,红 = 规则被破。四个检查器过不去,页面根本建不出来。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfcfb;strokeColor=#2a78d6;strokeWidth=2;fontColor=#1c1c1a;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="830" y="1024" width="300" height="56" as="geometry"/></mxCell><mxCell id="a_sync" value="工具更新时:sync.py 推入技能和模板,migrate.py 把数据形状逐步升级;你的数据一个字节不碰。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfcfb;strokeColor=#4a3aa7;strokeWidth=2;fontColor=#1c1c1a;fontSize=12;align=left;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="500" y="1102" width="300" height="56" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6b6f6c;strokeWidth=1.5;fontColor=#6b6f6c;fontSize=10;" edge="1" parent="1" source="t_open" target="t_demo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="觉得值得,就做成自己的" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6b6f6c;strokeWidth=1.5;fontColor=#6b6f6c;fontSize=10;" edge="1" parent="1" source="t_demo" target="s_drop"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6b6f6c;strokeWidth=1.5;fontColor=#6b6f6c;fontSize=10;" edge="1" parent="1" source="s_drop" target="s_say"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6b6f6c;strokeWidth=1.5;fontColor=#6b6f6c;fontSize=10;" edge="1" parent="1" source="s_say" target="s_draft"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="草稿按表格给你看" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6b6f6c;strokeWidth=1.5;fontColor=#6b6f6c;fontSize=10;" edge="1" parent="1" source="s_draft" target="s_ans"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6b6f6c;strokeWidth=1.5;fontColor=#6b6f6c;fontSize=10;" edge="1" parent="1" source="s_ans" target="s_write"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6b6f6c;strokeWidth=1.5;fontColor=#6b6f6c;fontSize=10;" edge="1" parent="1" source="s_write" target="s_page"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="同一批文件就是第一次导入:直接说「update dashboards」" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6b6f6c;strokeWidth=1.5;fontColor=#6b6f6c;fontSize=10;" edge="1" parent="1" source="s_page" target="m_say"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6b6f6c;strokeWidth=1.5;fontColor=#6b6f6c;fontSize=10;dashed=1;" edge="1" parent="1" source="m_remind" target="m_drop"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6b6f6c;strokeWidth=1.5;fontColor=#6b6f6c;fontSize=10;" edge="1" parent="1" source="m_drop" target="m_say"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6b6f6c;strokeWidth=1.5;fontColor=#6b6f6c;fontSize=10;" edge="1" parent="1" source="m_say" target="m_run"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6b6f6c;strokeWidth=1.5;fontColor=#6b6f6c;fontSize=10;" edge="1" parent="1" source="m_run" target="m_report"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6b6f6c;strokeWidth=1.5;fontColor=#6b6f6c;fontSize=10;" edge="1" parent="1" source="m_report" target="m_read"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="一句话" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6b6f6c;strokeWidth=1.5;fontColor=#6b6f6c;fontSize=10;" edge="1" parent="1" source="m_read" target="m_file"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="下个月" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6b6f6c;strokeWidth=1.5;fontColor=#6b6f6c;fontSize=10;dashed=1;" edge="1" parent="1" source="m_file" target="m_drop"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6b6f6c;strokeWidth=1.5;fontColor=#6b6f6c;fontSize=10;" edge="1" parent="1" source="m_report" target="a_dots"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6b6f6c;strokeWidth=1.5;fontColor=#6b6f6c;fontSize=10;" edge="1" parent="1" source="a_dots" target="a_look"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
